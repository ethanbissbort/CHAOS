# Project CHAOS -- deployment environment template.
#
#   cp deploy/.env.example deploy/.env
#   # then replace every CHANGE_ME with a value generated on this property
#
# deploy/.env is gitignored (see .gitignore: `.env`). NEVER commit real secrets.
#
# SDD section 15.2 requires per-device and per-service credentials: unique
# identities, not one shared homestead password. A single reused secret turns
# one compromised ESP32 in a greenhouse into broker-wide command authority.
# Generate values with, for example:
#
#   openssl rand -base64 30
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Every CHAOS_* variable here maps 1:1 onto a field of
# src/chaos/config.py (env_prefix = CHAOS_).

# ---------------------------------------------------------------------------
# Exposure
# ---------------------------------------------------------------------------
# Which host address the published ports bind to. Loopback by default: the
# firewall, not Docker, decides who reaches these services (SDD 15.1 is
# deny-by-default). Set to a VLAN 20 interface address once the addressing plan
# exists -- the asset register deliberately leaves host addressing TBD.
BIND_ADDRESS=127.0.0.1
TZ=America/Toronto

# ---------------------------------------------------------------------------
# PostgreSQL + PostGIS
# ---------------------------------------------------------------------------
POSTGRES_USER=homestead
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=homestead
POSTGRES_PORT=5432

# Optional: a separate, read-only role for Grafana. Create it in psql, then
# point Grafana at it. Grafana should not hold the owner credentials.
#   CREATE ROLE grafana_ro LOGIN PASSWORD '...';
#   GRANT CONNECT ON DATABASE homestead TO grafana_ro;
#   GRANT USAGE ON SCHEMA public TO grafana_ro;
#   GRANT SELECT ON ALL TABLES IN SCHEMA public TO grafana_ro;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT ON TABLES TO grafana_ro;
# GRAFANA_PG_USER=grafana_ro
# GRAFANA_PG_PASSWORD=CHANGE_ME_grafana_readonly_password

# ---------------------------------------------------------------------------
# MQTT (Mosquitto)
# ---------------------------------------------------------------------------
MQTT_PORT=1883
MQTT_TLS_PORT=8883

# The twin core's own broker identity. Distinct from every gateway identity.
CHAOS_MQTT_USERNAME=svc-twin-primary
CHAOS_MQTT_PASSWORD=CHANGE_ME_twin_mqtt_password
CHAOS_MQTT_TLS=false
CHAOS_MQTT_BASE_TOPIC=homestead
CHAOS_MQTT_ENABLED=true

# Optional least-privilege identity used only by the broker healthcheck. It needs
# read access to $SYS/broker/uptime and nothing else (see deploy/mosquitto/acl.example).
# Leave unset and the healthcheck falls back to checking that the broker process
# is alive -- weaker, but it does not report unhealthy just because anonymous
# access is correctly refused.
# MQTT_HEALTH_USER=svc-healthcheck
# MQTT_HEALTH_PASSWORD=CHANGE_ME_healthcheck_password

# ---------------------------------------------------------------------------
# Digital twin core
# ---------------------------------------------------------------------------
TWIN_IMAGE=chaos:local
TWIN_PORT=8000
CHAOS_SITE_ID=site.site.primary.01
CHAOS_HISTORIAN_BACKEND=sql
CHAOS_HISTORIAN_RAW_RETENTION_DAYS=90
CHAOS_EMS_ENABLED=true
CHAOS_ALARM_ENGINE_ENABLED=true
# Comma separated: log,email,push,voice
CHAOS_NOTIFICATION_BACKENDS=log

# THE SAFETY GATE.
# Leave false until the subsystem being controlled has passed all twelve steps
# of the SDD section 19 commissioning sequence and its commissioning record is
# in the registry. See docs/commissioning.md.
CHAOS_ALLOW_PHYSICAL_CONTROL=false

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=90d
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_admin_password

# ---------------------------------------------------------------------------
# Secondary control node (deploy/docker-compose.secondary.yml)
#
# This node lives in a different structure and is a different trust subject.
# Its secrets MUST differ from the primary's: if the power container burns, the
# credentials inside it should be assumed readable, not still valid elsewhere.
# ---------------------------------------------------------------------------
SECONDARY_BIND_ADDRESS=127.0.0.1
SECONDARY_POSTGRES_PASSWORD=CHANGE_ME_different_from_primary
SECONDARY_POSTGRES_PORT=5432
SECONDARY_MQTT_PORT=1883
SECONDARY_MQTT_TLS_PORT=8883
SECONDARY_MQTT_USERNAME=svc-twin-secondary
SECONDARY_MQTT_PASSWORD=CHANGE_ME_secondary_mqtt_password
# SECONDARY_MQTT_HEALTH_USER=svc-healthcheck
# SECONDARY_MQTT_HEALTH_PASSWORD=CHANGE_ME_secondary_healthcheck_password
SECONDARY_TWIN_PORT=8000
SECONDARY_GRAFANA_PORT=3000
SECONDARY_GRAFANA_ADMIN_PASSWORD=CHANGE_ME_secondary_grafana_password
SECONDARY_RAW_RETENTION_DAYS=14
SECONDARY_NOTIFICATION_BACKENDS=log

# ---------------------------------------------------------------------------
# Backups (deploy/backup/backup.sh)
# ---------------------------------------------------------------------------
BACKUP_DIR=/var/backups/homestead
BACKUP_KEEP_DAYS=30
# Paths to Node-RED and Home Assistant configuration on this host, if deployed.
# Both are named in SDD 8.3/8.4 and MVP acceptance criterion 5, but neither is
# part of this compose stack yet -- see docs/architecture.md.
# NODE_RED_DIR=/srv/node-red
# HOME_ASSISTANT_DIR=/srv/homeassistant
# Offsite/offline copy target. Must not be a filesystem inside the power
# container (SDD 16.1 mitigation 3).
# BACKUP_OFFSITE_TARGET=user@backup-host:/srv/homestead-backups
