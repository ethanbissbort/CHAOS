<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Chaos.Host.Supervisor supervises the Python platform as a child process of
    the .NET gateway.

    It targets the shared $(ChaosTargetFramework) (net10.0) — never a
    -windows TFM — so it builds, tests and runs on a Linux developer machine
    as well as in Visual Studio. Everything Windows-specific (Job Objects,
    console control events, the Event Log) is reached through P/Invoke or the
    System.Diagnostics.EventLog package behind an OperatingSystem.IsWindows()
    guard, and degrades to an honest, logged no-op elsewhere.
  -->

  <PropertyGroup>
    <TargetFramework>$(ChaosTargetFramework)</TargetFramework>
    <RootNamespace>Chaos.Host.Supervisor</RootNamespace>
    <AssemblyName>Chaos.Host.Supervisor</AssemblyName>
    <IsPackable>false</IsPackable>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      Required by the [LibraryImport] source generator, which emits the
      marshalling stubs for the Job Object and console-control P/Invokes.
      There is no hand-written unsafe code in this project: search for
      "unsafe" and you will find none outside obj/.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    The IBackendSupervisor contract is owned by the gateway agent. Where it
    physically lives decides how we consume it:

      * If windows/src/Chaos.Host.Abstractions exists, we reference it and the
        mirrored copy in Abstractions/BackendSupervisorContract.cs compiles out.
      * Otherwise we compile the mirror, so this project builds standalone.

    We deliberately do NOT reference Chaos.Host itself: Chaos.Host must
    reference us (it calls AddChaosBackendSupervisor), so referencing it back
    would be a project cycle. See README.md, "Contract ownership".

    Override the location with -p:ChaosHostAbstractionsProject=<path>.
  -->
  <PropertyGroup>
    <ChaosHostAbstractionsProject Condition="'$(ChaosHostAbstractionsProject)' == ''">$(MSBuildThisFileDirectory)..\Chaos.Host.Abstractions\Chaos.Host.Abstractions.csproj</ChaosHostAbstractionsProject>
    <UseExternalChaosAbstractions Condition="Exists('$(ChaosHostAbstractionsProject)')">true</UseExternalChaosAbstractions>
    <UseExternalChaosAbstractions Condition="'$(UseExternalChaosAbstractions)' == ''">false</UseExternalChaosAbstractions>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UseExternalChaosAbstractions)' == 'true'">
    <DefineConstants>$(DefineConstants);CHAOS_HOST_ABSTRACTIONS_EXTERNAL</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseExternalChaosAbstractions)' == 'true'">
    <ProjectReference Include="$(ChaosHostAbstractionsProject)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />
    <!-- Windows-only at runtime; ships a cross-platform facade that throws off
         Windows, which is why every call site is behind OperatingSystem.IsWindows(). -->
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Chaos.Host.Supervisor.Tests" />
  </ItemGroup>

</Project>
