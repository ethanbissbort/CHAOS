<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Chaos.Shell.LauncherWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The first thing an operator sees. It has to be readable and calm, not a
        wall of diagnostics: a headline, one paragraph, the checks, the things
        they can do about it, and — permanently — who owns the running platform.

        Everything shown here is decided by LauncherStateMachine in
        Chaos.Shell.Core and rendered verbatim. This file lays out boxes; it
        does not decide what goes in them.
    -->

    <Grid Background="{StaticResource ChaosShellBackground}" Padding="28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- headline + summary -->
            <RowDefinition Height="Auto" />
            <!-- run-mode banner -->
            <RowDefinition Height="Auto" />
            <!-- progress -->
            <RowDefinition Height="*" />
            <!-- checks, setup, notices -->
            <RowDefinition Height="Auto" />
            <!-- actions -->
            <RowDefinition Height="Auto" />
            <!-- log -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="6" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock x:Name="ProductText"
                       Foreground="{StaticResource ChaosShellMuted}"
                       FontSize="12" FontFamily="Consolas"
                       Text="PROJECT CHAOS" />
            <TextBlock x:Name="HeadlineText"
                       Foreground="{StaticResource ChaosShellText}"
                       FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"
                       Text="Starting Project CHAOS" />
            <TextBlock x:Name="SummaryText"
                       Foreground="{StaticResource ChaosShellMuted}"
                       FontSize="14" TextWrapping="Wrap" LineHeight="21"
                       Text="Looking for the platform." />
        </StackPanel>

        <!-- Who owns the running platform. Permanent, never collapsed: an
             operator must not be able to reach the exit without having been
             told whether closing the window stops their homestead. -->
        <Border x:Name="RunModeBorder" Grid.Row="1" Margin="0,18,0,0"
                Padding="14,12" CornerRadius="4"
                BorderThickness="1"
                BorderBrush="{StaticResource ChaosShellStroke}">
            <StackPanel Spacing="4">
                <TextBlock x:Name="RunModeHeadline"
                           FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"
                           Foreground="{StaticResource ChaosShellText}" />
                <TextBlock x:Name="RunModeDetail"
                           FontSize="13" TextWrapping="Wrap" LineHeight="19"
                           Foreground="{StaticResource ChaosShellMuted}" />
            </StackPanel>
        </Border>

        <StackPanel x:Name="ProgressPanel" Grid.Row="2" Margin="0,16,0,0" Spacing="6"
                    Visibility="Collapsed">
            <ProgressBar x:Name="Progress" IsIndeterminate="True"
                         Foreground="{StaticResource ChaosShellAccent}" />
            <TextBlock x:Name="ProgressText" FontFamily="Consolas" FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource ChaosShellMuted}" />
        </StackPanel>

        <ScrollViewer Grid.Row="3" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <StackPanel x:Name="NoticeList" Spacing="8" />
                <StackPanel x:Name="CheckList" Spacing="10" />

                <StackPanel x:Name="SetupPanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="First-run setup" FontWeight="SemiBold" FontSize="14"
                               Foreground="{StaticResource ChaosShellText}" />
                    <StackPanel x:Name="SetupRows" Spacing="8" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel x:Name="ActionList" Grid.Row="4" Margin="0,20,0,0" Spacing="10" />

        <StackPanel Grid.Row="5" Margin="0,16,0,0" Spacing="8">
            <Button x:Name="LogToggle" Content="Show platform log" Click="OnToggleLog"
                    Visibility="Collapsed" />
            <Border x:Name="LogBorder" Visibility="Collapsed"
                    BorderThickness="1" CornerRadius="4"
                    BorderBrush="{StaticResource ChaosShellStroke}">
                <TextBox x:Name="LogText" Height="180"
                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                         FontFamily="Consolas" FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         BorderThickness="0" />
            </Border>
        </StackPanel>
    </Grid>
</Window>
