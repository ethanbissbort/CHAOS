<?xml version="1.0" encoding="utf-8"?>
<!--
  Project CHAOS - Windows Installer (MSI) authoring.

  WHY MSI AND NOT MSIX
  ====================
  The desktop shell is WinUI 3, which normally suggests MSIX. It is the wrong
  container for this product, for four reasons that all matter more than the
  shell's packaging preference:

    1. The product IS a Windows Service. MSIX can declare a service only through
       the restricted `packagedServices` capability, with the binaries pinned
       inside an immutable package root and sharply limited control over the
       account and the recovery policy. This service supervises energy, water and
       freeze protection on an off-grid property; its restart-on-failure policy
       is not a detail to concede to a packaging format.

    2. It needs an inbound firewall rule. MSIX has no custom actions and no
       supported way to author a Windows Defender Firewall rule scoped to the
       private profile. The web UI has to be reachable from phones and wall
       displays on the LAN, and it has to be unreachable on a public profile.
       That is a rule, and a rule needs an installer that can create one.

    3. Uninstall must not destroy data. MSIX ties package state to the package.
       Here, uninstall must leave the alarm history, telemetry, database and
       logs completely untouched — see ProgramData.wxs, where every operator
       directory is Permanent.

    4. Offline, per-machine, on hardware the owner controls. MSIX per-machine
       deployment means provisioning and an always-required signed package from
       a trusted chain. `msiexec /i ... /qn` is what a person can run over a
       remote session on a homestead server with no internet.

  The WinUI 3 shell is published unpackaged and Windows App SDK self-contained
  (WindowsPackageType=None, WindowsAppSDKSelfContained=true), so nothing here
  depends on a Windows App SDK runtime being installed, and the installer never
  has to download anything.

  BUILT BY windows\build\build.ps1 -Task package, not by Visual Studio. It needs
  the pinned `wix` dotnet tool plus the Util, Firewall and UI extensions; the
  build script installs them under windows\build\out\tools.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <?include Chaos.Definitions.wxi ?>

  <Package Name="$(var.ChaosProductName)"
           Manufacturer="$(var.ChaosManufacturer)"
           Version="$(var.ChaosVersion)"
           UpgradeCode="9479D117-1584-4E1A-8899-4D9499D4EB45"
           Language="1033"
           Scope="perMachine"
           InstallerVersion="500"
           Compressed="yes">

    <SummaryInformation Description="$(var.ChaosProductName) - homestead control platform"
                        Manufacturer="$(var.ChaosManufacturer)" />

    <!--
      Upgrades. The UpgradeCode above must NEVER change: it is what makes
      version N+1 replace version N instead of installing beside it. Two copies
      of this service on one machine, each with its own supervisor and each
      trying to bind the LAN port, is a genuinely bad afternoon.

      Scheduled afterInstallExecute so the old files are removed after the new
      ones are laid down; that keeps the service registration continuous rather
      than removing and re-adding it, which is what leaves orphaned services.
    -->
    <MajorUpgrade Schedule="afterInstallExecute"
                  AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of $(var.ChaosProductName) is already installed. Uninstall it first if you really mean to go backwards; your data under %ProgramData%\$(var.ChaosProductName) is not touched by an uninstall." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- 64-bit only. The embedded interpreter is the amd64 embeddable build. -->
    <Launch Condition="VersionNT64" Message="$(var.ChaosProductName) requires 64-bit Windows." />
    <!-- Windows 10 1809 / Server 2019 or newer: the floor set by the Windows App SDK. -->
    <Launch Condition="Installed OR (VersionNT &gt;= 603)"
            Message="$(var.ChaosProductName) requires Windows 10 version 1809 or newer." />

    <!-- ================================================================
         Directories
         ================================================================
         The install root layout is a CONTRACT with the supervisor:

             <install root>\Chaos.Host.exe        AppContext.BaseDirectory
             <install root>\python\python.exe     <— resolved relative to it
             <install root>\app\{data,schemas,tools,web}

         The .NET files sit flat in the root precisely so that "the install
         root" and "the directory the host runs from" are the same directory
         and nobody has to walk up a level and guess.
    -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="$(var.ChaosProductName)" />
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="CHAOSDATAFOLDER" Name="$(var.ChaosProductName)">
        <Directory Id="CHAOSDATACONFIG"  Name="config" />
        <Directory Id="CHAOSDATADB"      Name="db" />
        <Directory Id="CHAOSDATALOGS"    Name="logs" />
        <Directory Id="CHAOSDATABACKUPS" Name="backups" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="CHAOSMENUFOLDER" Name="$(var.ChaosProductName)" />
    </StandardDirectory>

    <!-- ================================================================
         Features
         ================================================================
         One feature. A homestead operator choosing whether to install "the
         Python runtime" is a support call waiting to happen; the product is
         the whole thing or none of it. The firewall rule is the only genuinely
         optional piece, and it is controlled by a property (see Firewall.wxs)
         rather than a feature tree, so it can be set on a silent command line.
    -->
    <Feature Id="Main" Title="$(var.ChaosProductName)" Level="1" AllowAdvertise="no" Display="expand"
             Description="Gateway, supervisor, desktop shell, embedded Python runtime and design package.">
      <ComponentGroupRef Id="ChaosHostService" />
      <ComponentGroupRef Id="ChaosPayload" />
      <ComponentGroupRef Id="ChaosProgramData" />
      <ComponentGroupRef Id="ChaosRegistration" />
      <ComponentGroupRef Id="ChaosShortcuts" />
      <ComponentGroupRef Id="ChaosFirewall" />
    </Feature>

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="!(bindpath.Installer)\License.rtf" />

    <!--
      Told plainly on the last page of the installer and in the uninstall
      warning, because it is the property most worth being sure about.
    -->
    <Property Id="ARPCOMMENTS"
              Value="Operator data (database, logs, backups and local config) lives in %ProgramData%\$(var.ChaosProductName) and is NOT removed by uninstall." />
    <Property Id="ARPHELPLINK" Value="https://github.com/ethanbissbort/CHAOS" />
    <Property Id="ARPPRODUCTICON" Value="ChaosIcon" />
    <!-- ARPNOMODIFY is set by WixUI_Minimal; setting it again here is a
         duplicate-symbol error at link time. -->

    <!-- The icon comes off the host, not the shell: the host is always present,
         the shell is skipped if windows\src has no Chaos.Shell.csproj yet. -->
    <Icon Id="ChaosIcon" SourceFile="!(bindpath.Stage)\$(var.ChaosHostExe)" />
  </Package>

  <!-- ==================================================================
       Registration: the discovery surface the .NET side reads at runtime.
       ==================================================================
       Registry first, environment second, and deliberately so.

       Machine environment variables are NOT reliable for a service: the
       Service Control Manager hands each service the environment block it
       inherited at boot, so a variable written by an installer is not visible
       to a service started in the same session as that install. Everything the
       HOST needs it therefore reads from HKLM below (always current) or from
       %ProgramData%\...\config. The environment variables exist for the human
       at an elevated prompt, and for chaos.cmd, not for the service.
  -->
  <Fragment>
    <ComponentGroup Id="ChaosRegistration">

      <Component Id="ChaosRegistryKeys" Directory="INSTALLFOLDER"
                 Guid="00ACF1E3-2B7A-4DC1-BE76-97AB98B1180B">
        <RegistryKey Root="HKLM" Key="SOFTWARE\$(var.ChaosProductName)" ForceDeleteOnUninstall="yes">
          <RegistryValue Name="InstallDir"      Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
          <RegistryValue Name="DataDir"         Type="string" Value="[CHAOSDATAFOLDER]" />
          <!-- The python path contract, written down where code can read it
               instead of being reconstructed by string concatenation. -->
          <RegistryValue Name="PythonExe"       Type="string" Value="[INSTALLFOLDER]$(var.ChaosPythonExeRelPath)" />
          <RegistryValue Name="AppDir"          Type="string" Value="[INSTALLFOLDER]app\" />
          <RegistryValue Name="WebRoot"         Type="string" Value="[INSTALLFOLDER]app\web\" />
          <RegistryValue Name="ConfigDir"       Type="string" Value="[CHAOSDATACONFIG]" />
          <RegistryValue Name="LogDir"          Type="string" Value="[CHAOSDATALOGS]" />
          <RegistryValue Name="ServiceName"     Type="string" Value="$(var.ChaosServiceName)" />
          <RegistryValue Name="LanPort"         Type="integer" Value="$(var.ChaosLanPort)" />
          <RegistryValue Name="Version"         Type="string" Value="$(var.ChaosVersion)" />
          <RegistryValue Name="PlatformVersion" Type="string" Value="$(var.ChaosPlatformVersion)" />
        </RegistryKey>
      </Component>

      <Component Id="ChaosEnvironment" Directory="INSTALLFOLDER"
                 Guid="8160C1C8-1FDC-4242-A343-336DF674BFB1">
        <RegistryValue Root="HKLM" Key="SOFTWARE\$(var.ChaosProductName)\State"
                       Name="EnvironmentInstalled" Type="integer" Value="1" KeyPath="yes" />

        <Environment Id="EnvChaosHome"   Name="CHAOS_HOME"   Value="[INSTALLFOLDER]"      Action="set" Part="all" System="yes" />
        <Environment Id="EnvChaosData"   Name="CHAOS_DATA"   Value="[CHAOSDATAFOLDER]"    Action="set" Part="all" System="yes" />
        <Environment Id="EnvChaosPython" Name="CHAOS_PYTHON" Value="[INSTALLFOLDER]$(var.ChaosPythonExeRelPath)" Action="set" Part="all" System="yes" />
        <Environment Id="EnvChaosWeb"    Name="CHAOS_WEB_ROOT" Value="[INSTALLFOLDER]app\web" Action="set" Part="all" System="yes" />

        <!-- The Python side. CHAOS_DATA_DIR's parent is what
             chaos.cli.workspace_root() anchors on, so pointing it at
             <install>\app\data is what makes `validate` and `load-all` work
             offline with no repository checkout, exactly as they do in the
             container image. -->
        <Environment Id="EnvDataDir"   Name="CHAOS_DATA_DIR"   Value="[INSTALLFOLDER]app\data"    Action="set" Part="all" System="yes" />
        <Environment Id="EnvSchemaDir" Name="CHAOS_SCHEMA_DIR" Value="[INSTALLFOLDER]app\schemas" Action="set" Part="all" System="yes" />

        <!-- Loopback only. The Python backend is reached through the .NET
             gateway; it has no business listening on the LAN. The firewall rule
             opens the gateway's port and nothing else, but a service that binds
             0.0.0.0 is one firewall mistake away from being exposed, so the
             default is corrected here as well. -->
        <Environment Id="EnvApiHost" Name="CHAOS_API_HOST" Value="127.0.0.1" Action="set" Part="all" System="yes" />
      </Component>

    </ComponentGroup>
  </Fragment>

  <!-- ==================================================================
       Start-menu shortcuts
       ==================================================================
       Two, as asked for: the console and the annunciator panel. Both are the
       WinUI 3 shell; the annunciator is a second window, so it is the same
       executable with an argument.

       CONTRACT WITH THE SHELL: the shell must open the annunciator window
       directly when passed the switch spelled "annunciator" with the usual two
       leading hyphens (see the Arguments attribute below, which carries the
       literal). If the shell settles on a different switch, the Arguments
       attribute below is the one line to change.
  -->
  <Fragment>
    <ComponentGroup Id="ChaosShortcuts">
      <Component Id="ChaosStartMenu" Directory="CHAOSMENUFOLDER"
                 Guid="2FABDD5C-FCB4-4213-A67B-363F6E5B641F">
        <RegistryValue Root="HKLM" Key="SOFTWARE\$(var.ChaosProductName)\State"
                       Name="ShortcutsInstalled" Type="integer" Value="1" KeyPath="yes" />

        <Shortcut Id="ShortcutConsole"
                  Name="$(var.ChaosProductName) Console"
                  Description="Operator console for the homestead control platform."
                  Target="[INSTALLFOLDER]$(var.ChaosShellExe)"
                  WorkingDirectory="INSTALLFOLDER" />

        <Shortcut Id="ShortcutAnnunciator"
                  Name="$(var.ChaosProductName) Annunciator"
                  Description="Alarm annunciator panel: one lamp per condition."
                  Target="[INSTALLFOLDER]$(var.ChaosShellExe)"
                  Arguments="--annunciator"
                  WorkingDirectory="INSTALLFOLDER" />

        <RemoveFolder Id="RemoveChaosMenuFolder" Directory="CHAOSMENUFOLDER" On="uninstall" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
