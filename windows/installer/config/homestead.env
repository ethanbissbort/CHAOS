# Project CHAOS - Python backend overrides
#
# Written once by the installer. NEVER overwritten by an upgrade and NEVER
# removed by an uninstall.
#
# Every setting in src/homestead_twin/config.py is overridable here as
# HOMESTEAD_<FIELD>. The supervisor reads this file and passes the values to the
# Python child process; it does not rely on machine environment variables,
# because the Service Control Manager hands a service the environment block it
# inherited at boot and an installer cannot change that for a service starting
# in the same session.
#
# Everything is commented out. The defaults the supervisor supplies are:
#
#   HOMESTEAD_DATA_DIR       <install root>\app\data
#   HOMESTEAD_SCHEMA_DIR     <install root>\app\schemas
#   HOMESTEAD_DATABASE_URL   sqlite:///C:/ProgramData/Project CHAOS/db/homestead.db
#   HOMESTEAD_API_HOST       127.0.0.1        (loopback only, on purpose)
#   HOMESTEAD_API_PORT       8081
#
# Uncomment and restart the service to change one:  Restart-Service ChaosHost

# --- Identity ---------------------------------------------------------------
# primary | secondary. A secondary control node observes and alerts and
# deliberately cannot issue commands (SDD 16.1). If this node is the one in a
# separate structure, set it here and confirm with:  chaos.cmd status
#HOMESTEAD_NODE_ROLE=primary
#HOMESTEAD_SITE_ID=site.site.primary.01
#HOMESTEAD_TIMEZONE=America/Toronto

# --- Storage ----------------------------------------------------------------
# Forward slashes, even on Windows: this is a SQLAlchemy URL, not a path.
# PostgreSQL needs the "postgres" extra in the embedded runtime; rebuild it with
#   .\build.ps1 -Task runtime -IncludePostgres
#HOMESTEAD_DATABASE_URL=sqlite:///C:/ProgramData/Project CHAOS/db/homestead.db

# --- MQTT -------------------------------------------------------------------
# false runs the API with no bus and no background services. Leave it false
# until a broker exists and per-device credentials have been issued
# (deploy/mosquitto/README.md); one shared secret turns a compromised greenhouse
# sensor into broker-wide command authority.
#HOMESTEAD_MQTT_ENABLED=false
#HOMESTEAD_MQTT_HOST=127.0.0.1
#HOMESTEAD_MQTT_PORT=1883
#HOMESTEAD_MQTT_USERNAME=
#HOMESTEAD_MQTT_PASSWORD=

# --- The safety gate --------------------------------------------------------
# THE global master switch for physical control. It defaults to false and it
# should stay false until the subsystem you intend to control has passed all
# twelve steps of the SDD section 19 commissioning sequence and has the records
# to show for it. Enabling it does not arm anything that has not been
# commissioned -- per-binding gates still apply -- but it is the switch that
# makes the platform capable of moving plant. See docs/commissioning.md.
#HOMESTEAD_ALLOW_PHYSICAL_CONTROL=false

# --- EMS and alarms ---------------------------------------------------------
#HOMESTEAD_EMS_ENABLED=true
#HOMESTEAD_ALARM_ENGINE_ENABLED=true
# log is what is actually wired. email, push and voice are named but check
# src/homestead_twin/alarms/notify.py before relying on one to wake anybody up.
#HOMESTEAD_NOTIFICATION_BACKENDS=log

# --- Retention (SDD 16.4) ---------------------------------------------------
#HOMESTEAD_HISTORIAN_RAW_RETENTION_DAYS=90
