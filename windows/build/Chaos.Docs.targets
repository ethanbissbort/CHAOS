<Project>

  <!--
    ===========================================================================
    Generate the offline documentation site from Visual Studio.

    tools/build_docs.py turns the Markdown in docs/ into a static, fully offline
    site under src/chaos/web/docs/ (plus a single-file build in the same place).
    Chaos.Host then serves that directory on its own port - see
    Chaos.Host/Docs/DocumentationSite.cs.

    Building it was previously not possible from a build at all. It is now a
    target, so the manual is produced by pressing Build, like everything else.

    INCREMENTAL ON THE MARKDOWN
    ===========================
        Inputs  : docs/**/*.md, README.md, and the generator itself.
        Outputs : the generated index.html, plus a stamp.

    Editing a manual regenerates the site on the next build; not editing one
    costs nothing. Generation is seconds, not minutes, so unlike the Python
    runtime it is not something to be afraid of.

    WHICH PYTHON
    ============
    The embedded runtime this build produces, if it is there; otherwise
    whatever Python is on PATH. In that order on purpose: the embedded
    interpreter is the one the product ships and the one whose dependencies are
    pinned, so the manual is generated by the same Python that serves the
    platform.

    WHAT A FAILURE DOES
    ===================
    Reports, loudly, and lets the build finish.

    That is a deliberate choice and not laziness. The generator is also a
    quality gate on the documentation: it refuses to write a site with a broken
    cross-reference. Prose is edited by people who are not editing the control
    plane, so a dead link in a manual would otherwise stop the gateway from
    building and stop an F5 dead — a build break with no connection whatsoever
    to the change being made. The generator's own output is printed in full, at
    high importance, so it is visible in the Output window at Visual Studio's
    default verbosity; the previously generated site (which is committed to the
    repository) keeps being served in the meantime.

    Set ChaosDocsGenerationFailsBuild to true to make it a hard error instead —
    which is what a release or a CI run wants.
    ===========================================================================
  -->

  <PropertyGroup>
    <ChaosBuildDir Condition="'$(ChaosBuildDir)' == ''">$(MSBuildThisFileDirectory)</ChaosBuildDir>
    <ChaosRepoRoot Condition="'$(ChaosRepoRoot)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..'))</ChaosRepoRoot>
    <ChaosBuildOutDir Condition="'$(ChaosBuildOutDir)' == ''">$(ChaosBuildDir)out\</ChaosBuildOutDir>

    <ChaosDocsGenerator Condition="'$(ChaosDocsGenerator)' == ''">$(ChaosRepoRoot)tools\build_docs.py</ChaosDocsGenerator>

    <!-- Where the generator writes, by default. This must stay in step with
         DocumentationRootResolver in Chaos.Host, which looks for a "docs"
         directory inside the operator console's web root: the same directory,
         reached the same way, whether it is a checkout or an install.

         index.html is the directory site's entry page; the single-file build
         (chaos-help-offline.html) lands beside it and is served like any other
         file. -->
    <ChaosDocsOutputDir Condition="'$(ChaosDocsOutputDir)' == ''">$(ChaosRepoRoot)src\chaos\web\docs\</ChaosDocsOutputDir>
    <ChaosDocsIndexFile Condition="'$(ChaosDocsIndexFile)' == ''">$(ChaosDocsOutputDir)index.html</ChaosDocsIndexFile>
    <ChaosDocsStamp Condition="'$(ChaosDocsStamp)' == ''">$(ChaosBuildOutDir)docs.stamp</ChaosDocsStamp>

    <!-- False: a documentation problem must not break the control plane's
         build. See WHAT A FAILURE DOES above. -->
    <ChaosDocsGenerationFailsBuild Condition="'$(ChaosDocsGenerationFailsBuild)' == ''">false</ChaosDocsGenerationFailsBuild>

    <!-- Extra arguments for the generator. Empty by default: it is written to
         need none, and passing options it does not have would be worse than
         passing none at all. -->
    <ChaosDocsGeneratorArgs Condition="'$(ChaosDocsGeneratorArgs)' == ''"></ChaosDocsGeneratorArgs>

    <ChaosBuildDocs Condition="'$(ChaosBuildDocs)' == ''">true</ChaosBuildDocs>

    <!-- See Chaos.PythonRuntime.targets: this is the embedded interpreter. The
         condition is Exists() rather than IsOSPlatform, so a machine that has
         built the runtime uses it and every other machine falls back. -->
    <ChaosPythonExe Condition="'$(ChaosPythonExe)' == ''">$(ChaosBuildDir)out\stage\python\python.exe</ChaosPythonExe>
    <ChaosDocsPython Condition="'$(ChaosDocsPython)' == '' AND Exists('$(ChaosPythonExe)')">$(ChaosPythonExe)</ChaosDocsPython>
    <ChaosDocsPython Condition="'$(ChaosDocsPython)' == '' AND '$([MSBuild]::IsOSPlatform(`Windows`))' == 'true'">python</ChaosDocsPython>
    <ChaosDocsPython Condition="'$(ChaosDocsPython)' == ''">python3</ChaosDocsPython>

    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3073</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <ChaosDocsInput Include="$(ChaosRepoRoot)docs\**\*.md" />
    <ChaosDocsInput Include="$(ChaosRepoRoot)README.md" />
    <ChaosDocsInput Include="$(ChaosDocsGenerator)" Condition="Exists('$(ChaosDocsGenerator)')" />
  </ItemGroup>

  <Target Name="ChaosBuildDocumentation"
          BeforeTargets="Build"
          Condition="'$(ChaosBuildDocs)' == 'true' AND Exists('$(ChaosDocsGenerator)')"
          Inputs="@(ChaosDocsInput)"
          Outputs="$(ChaosDocsStamp);$(ChaosDocsIndexFile)">

    <Message Importance="high" Text="Project CHAOS: generating the offline documentation site." />
    <Message Importance="high" Text="  generator : $(ChaosDocsGenerator)" />
    <Message Importance="high" Text="  python    : $(ChaosDocsPython)" />
    <Message Importance="high" Text="  output    : $(ChaosDocsOutputDir)" />

    <MakeDir Directories="$(ChaosBuildOutDir)" />

    <Exec Command="&quot;$(ChaosDocsPython)&quot; &quot;$(ChaosDocsGenerator)&quot; $(ChaosDocsGeneratorArgs)"
          WorkingDirectory="$(ChaosRepoRoot)"
          StandardOutputImportance="high"
          StandardErrorImportance="high"
          IgnoreStandardErrorWarningFormat="true"
          ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="ChaosDocsExitCode" />
    </Exec>

    <!-- 9009 is cmd.exe's "is not recognized as an internal or external
         command"; 127 is the shell's equivalent. Both mean "no interpreter",
         which is a situation to explain, not a build to fail. -->
    <PropertyGroup>
      <ChaosDocsNoPython Condition="'$(ChaosDocsExitCode)' == '9009' OR '$(ChaosDocsExitCode)' == '127'">true</ChaosDocsNoPython>
    </PropertyGroup>

    <Message Importance="high"
             Condition="'$(ChaosDocsNoPython)' == 'true'"
             Text="Project CHAOS: the documentation site was NOT generated - no Python interpreter was found at '$(ChaosDocsPython)'. Build the embedded Python runtime (right-click Chaos.Runtime in Solution Explorer, Build) or install Python, then build again. The documentation listener explains this on every page it serves in the meantime." />

    <Message Importance="high"
             Condition="'$(ChaosDocsExitCode)' != '0' AND '$(ChaosDocsNoPython)' != 'true'"
             Text="Project CHAOS: the documentation site was NOT regenerated - $(ChaosDocsGenerator) exited with code $(ChaosDocsExitCode). Its own output is above and says what is wrong with the documentation; it refuses to write a site it knows to be broken. The build continues on purpose, and the previously generated site keeps being served. Set ChaosDocsGenerationFailsBuild to true in Chaos.Runtime.csproj to make this a build error instead." />

    <Error Condition="'$(ChaosDocsExitCode)' != '0' AND '$(ChaosDocsNoPython)' != 'true' AND '$(ChaosDocsGenerationFailsBuild)' == 'true'"
           Code="CHAOS0003"
           File="$(ChaosDocsGenerator)"
           Text="The documentation site could not be generated (exit code $(ChaosDocsExitCode)). The generator's own output is above this error." />

    <Touch Files="$(ChaosDocsStamp)" AlwaysCreate="true" Condition="'$(ChaosDocsExitCode)' == '0'" />

    <Message Importance="high"
             Condition="'$(ChaosDocsExitCode)' == '0'"
             Text="Project CHAOS: documentation site generated into $(ChaosDocsOutputDir)" />
  </Target>

  <Target Name="ChaosDocumentationGeneratorMissing"
          BeforeTargets="Build"
          Condition="'$(ChaosBuildDocs)' == 'true' AND !Exists('$(ChaosDocsGenerator)')">
    <Message Importance="high"
             Text="Project CHAOS: the documentation site was NOT generated - $(ChaosDocsGenerator) is not in this checkout. Nothing else is affected; the documentation listener explains the situation on every page it serves." />
  </Target>

</Project>
