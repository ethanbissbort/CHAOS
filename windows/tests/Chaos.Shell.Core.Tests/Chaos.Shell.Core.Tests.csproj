<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the cross-platform half of the shell. Targets net10.0 (not
    net10.0-windows) on purpose: these run in Visual Studio 2026 on the owner's
    machine and on a Linux box or CI leg, and they are the only automated check
    the desktop shell has, because the WinUI 3 project cannot be compiled off
    Windows.
  -->

  <PropertyGroup>
    <TargetFramework>$(ChaosTargetFramework)</TargetFramework>
    <RootNamespace>Chaos.Shell.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Chaos.Shell.Core/Chaos.Shell.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
