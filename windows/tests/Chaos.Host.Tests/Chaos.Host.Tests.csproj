<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the CHAOS gateway.

    Hermetic by construction: no Python backend, no fixed ports, no network.
    The proxy tests stand up a stub backend as a second in-process
    WebApplication bound to 127.0.0.1:0, and the operator-console tests build
    their own asset fixture in a temp directory.
  -->

  <PropertyGroup>
    <TargetFramework>$(ChaosTargetFramework)</TargetFramework>
    <AssemblyName>Chaos.Host.Tests</AssemblyName>
    <RootNamespace>Chaos.Host.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Chaos.Host\Chaos.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
