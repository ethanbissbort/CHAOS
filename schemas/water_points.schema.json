{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homestead.local/schemas/water-points.schema.json",
  "title": "Homestead Water Point Dictionary Extension",
  "description": "Point-dictionary extension carrying the water points required by FR-200 to FR-205. Records use the same shape as data/point_dictionary.yaml so the two documents merge by key.",
  "type": "object",
  "required": [
    "schema_version",
    "document_type",
    "document_status",
    "generated_at",
    "extends",
    "merge_target",
    "provenance",
    "point_name_pattern",
    "point_path_format",
    "points",
    "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "document_type": {
      "const": "point_dictionary_extension"
    },
    "document_status": {
      "const": "extension_for_review"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "extends": {
      "type": "string"
    },
    "merge_target": {
      "type": "string"
    },
    "source_document": {
      "type": "string"
    },
    "work_queue_item": {
      "type": "string"
    },
    "control_narrative": {
      "type": "string"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "required": [
        "dictionary_status",
        "convention"
      ],
      "additionalProperties": false,
      "properties": {
        "dictionary_status": {
          "const": "reconciled_v0_4"
        },
        "convention": {
          "type": "string"
        }
      }
    },
    "point_name_pattern": {
      "type": "string"
    },
    "point_path_format": {
      "type": "string"
    },
    "canonical_units_added": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "reused_existing_points": {
      "type": "object",
      "required": [
        "description",
        "points"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true
        }
      }
    },
    "points": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "default_class",
          "allowed_classes",
          "data_type",
          "unit",
          "description",
          "control_capable",
          "automatic_control_default",
          "applicable_asset_classes",
          "source_section",
          "dictionary_status"
        ],
        "additionalProperties": false,
        "properties": {
          "default_class": {
            "enum": [
              "AI",
              "DI",
              "AO",
              "DO",
              "CALC",
              "CFG",
              "EVENT",
              "ALARM",
              "COUNTER",
              "TEXT"
            ]
          },
          "allowed_classes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "AI",
                "DI",
                "AO",
                "DO",
                "CALC",
                "CFG",
                "EVENT",
                "ALARM",
                "COUNTER",
                "TEXT"
              ]
            }
          },
          "data_type": {
            "enum": [
              "float",
              "integer",
              "boolean",
              "string",
              "enum",
              "object"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "control_capable": {
            "type": "boolean"
          },
          "automatic_control_default": {
            "type": "boolean"
          },
          "applicable_asset_classes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "uniqueItems": true
          },
          "source_section": {
            "type": "string"
          },
          "dictionary_status": {
            "const": "reconciled_v0_4"
          },
          "enum_values": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            },
            "uniqueItems": true
          },
          "physical_range": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "minimum": {
                "type": "number"
              },
              "maximum": {
                "type": "number"
              }
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  }
}
