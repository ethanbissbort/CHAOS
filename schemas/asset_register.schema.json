{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homestead.local/schemas/asset-register.schema.json",
  "title": "Homestead Asset Register",
  "type": "object",
  "required": [
    "schema_version",
    "document_type",
    "registry_id",
    "generated_at",
    "site_id",
    "design_basis",
    "assets",
    "relationships",
    "register_notes"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "document_type": {
      "const": "asset_register"
    },
    "registry_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "site_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){3,}$"
    },
    "design_basis": {
      "type": "object"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "domain",
          "asset_class",
          "name",
          "status",
          "criticality",
          "control_authority",
          "functional_position",
          "parent_id",
          "location",
          "properties",
          "external_identifiers",
          "network",
          "power",
          "dependencies",
          "manual_override",
          "documentation",
          "maintenance_plan",
          "point_profile_refs",
          "source_refs",
          "notes",
          "open_fields",
          "tags"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){3,}$"
          },
          "domain": {
            "enum": [
              "site",
              "structure",
              "energy",
              "water",
              "agriculture",
              "storage",
              "spa",
              "it",
              "security",
              "workshop",
              "fuel",
              "safety"
            ]
          },
          "asset_class": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "concept",
              "planned",
              "procured",
              "installed",
              "commissioned",
              "active",
              "degraded",
              "failed",
              "maintenance",
              "reserve",
              "retired"
            ]
          },
          "criticality": {
            "enum": [
              "life_safety",
              "critical",
              "important",
              "discretionary"
            ]
          },
          "control_authority": {
            "enum": [
              "none",
              "manual",
              "local_only",
              "vendor_native",
              "supervisory",
              "local_controller_with_supervisory_setpoints",
              "safety_interlock"
            ]
          },
          "functional_position": {
            "type": "boolean"
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "location": {
            "type": "object"
          },
          "properties": {
            "type": "object"
          },
          "external_identifiers": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "network": {
            "type": "object"
          },
          "power": {
            "type": "object"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "manual_override": {
            "type": "object"
          },
          "documentation": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "maintenance_plan": {
            "type": "object"
          },
          "point_profile_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "document",
                "section"
              ],
              "properties": {
                "document": {
                  "type": "string"
                },
                "section": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "open_fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "relationship_id",
          "from_asset_id",
          "relationship_type",
          "to_asset_id",
          "status",
          "notes"
        ],
        "properties": {
          "relationship_id": {
            "type": "string",
            "pattern": "^rel\\.\\d{4,}$"
          },
          "from_asset_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){3,}$"
          },
          "relationship_type": {
            "enum": [
              "contains",
              "located_in",
              "feeds",
              "returns_to",
              "controls",
              "monitors",
              "protects",
              "depends_on",
              "backs_up",
              "measures",
              "serves",
              "part_of",
              "associated_with",
              "replaces",
              "connected_to",
              "hosts",
              "managed_by"
            ]
          },
          "to_asset_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){3,}$"
          },
          "status": {
            "enum": [
              "concept",
              "planned",
              "procured",
              "installed",
              "commissioned",
              "active",
              "degraded",
              "failed",
              "maintenance",
              "reserve",
              "retired"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "register_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
