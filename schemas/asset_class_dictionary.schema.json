{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homestead.local/schemas/asset-class-dictionary.schema.json",
  "title": "Homestead Asset Class Dictionary",
  "type": "object",
  "required": [
    "schema_version",
    "document_type",
    "domains",
    "lifecycle_statuses",
    "criticality_levels",
    "control_authorities",
    "relationship_types",
    "asset_classes",
    "point_profiles"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "document_type": {
      "const": "asset_class_dictionary"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_document": {
      "type": "string"
    },
    "domains": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "lifecycle_statuses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "criticality_levels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "control_authorities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "relationship_types": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "asset_classes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "purpose",
          "allowed_domains",
          "required_properties",
          "default_points",
          "source_section",
          "dictionary_status"
        ],
        "properties": {
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "allowed_domains": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "required_properties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "default_points": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "uniqueItems": true
          },
          "source_section": {
            "type": "string"
          },
          "dictionary_status": {
            "enum": [
              "baseline_v0_2",
              "reconciled_v0_3"
            ]
          },
          "superclass": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "point_profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "uniqueItems": true
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
