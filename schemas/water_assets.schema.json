{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homestead.local/schemas/water-assets.schema.json",
  "title": "Homestead Water Asset Register Extension",
  "description": "Water-domain extension to the homestead asset register. Uses the base register's asset and relationship record shape so the two documents merge by concatenation.",
  "type": "object",
  "required": [
    "schema_version",
    "document_type",
    "document_status",
    "generated_at",
    "extends",
    "merge_target",
    "site_id",
    "design_basis",
    "assets",
    "relationships",
    "extension_notes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "document_type": {
      "const": "water_asset_extension"
    },
    "document_status": {
      "const": "concept_extension_for_review"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "extends": {
      "type": "string"
    },
    "merge_target": {
      "type": "string"
    },
    "site_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){3}$"
    },
    "source_document": {
      "type": "string"
    },
    "work_queue_item": {
      "type": "string"
    },
    "control_narrative": {
      "type": "string"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "merge_rules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "asset_class_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "needed_for",
          "missing_class",
          "workaround"
        ],
        "additionalProperties": false,
        "properties": {
          "needed_for": {
            "type": "string"
          },
          "missing_class": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "workaround": {
            "type": "string"
          }
        }
      }
    },
    "design_basis": {
      "type": "object"
    },
    "asset_class_usage": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "domain",
          "asset_class",
          "name",
          "status",
          "criticality",
          "control_authority",
          "functional_position",
          "parent_id",
          "location",
          "properties",
          "external_identifiers",
          "network",
          "power",
          "dependencies",
          "manual_override",
          "documentation",
          "maintenance_plan",
          "point_profile_refs",
          "source_refs",
          "notes",
          "open_fields",
          "tags"
        ],
        "additionalProperties": false,
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){3}$"
          },
          "domain": {
            "enum": [
              "site",
              "structure",
              "energy",
              "water",
              "agriculture",
              "storage",
              "spa",
              "it",
              "security",
              "workshop",
              "fuel",
              "safety"
            ]
          },
          "asset_class": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "concept",
            "description": "No water infrastructure exists; every record in this extension is a concept."
          },
          "criticality": {
            "enum": [
              "life_safety",
              "critical",
              "important",
              "discretionary"
            ]
          },
          "control_authority": {
            "enum": [
              "none",
              "manual",
              "local_only",
              "vendor_native",
              "supervisory",
              "local_controller_with_supervisory_setpoints",
              "safety_interlock"
            ]
          },
          "functional_position": {
            "type": "boolean"
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){3}$"
          },
          "location": {
            "type": "object"
          },
          "properties": {
            "type": "object"
          },
          "external_identifiers": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "network": {
            "type": "object"
          },
          "power": {
            "type": "object"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "manual_override": {
            "type": "object"
          },
          "documentation": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "maintenance_plan": {
            "type": "object"
          },
          "point_profile_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "document",
                "section"
              ],
              "additionalProperties": false,
              "properties": {
                "document": {
                  "type": "string"
                },
                "section": {
                  "type": "string"
                }
              }
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "open_fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "minItems": 1,
            "description": "Every concept asset has at least one unknown; an empty list would be a lie."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "relationship_id",
          "from_asset_id",
          "relationship_type",
          "to_asset_id",
          "status",
          "notes"
        ],
        "additionalProperties": false,
        "properties": {
          "relationship_id": {
            "type": "string",
            "pattern": "^rel\\.\\d{4,}$"
          },
          "from_asset_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){3}$"
          },
          "relationship_type": {
            "enum": [
              "contains",
              "located_in",
              "feeds",
              "returns_to",
              "controls",
              "monitors",
              "protects",
              "depends_on",
              "backs_up",
              "measures",
              "serves",
              "part_of",
              "associated_with",
              "replaces",
              "connected_to",
              "hosts",
              "managed_by"
            ]
          },
          "to_asset_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){3}$"
          },
          "status": {
            "const": "concept"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "extension_notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  }
}
